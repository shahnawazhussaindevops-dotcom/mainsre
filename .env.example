# ── SREAI configuration ───────────────────────────────────────────────
# Copy this file to ".env" and fill in what you need. Everything is optional.

# Optional: enables REAL LLM-powered incident analysis.
# Provide ONE of these. If both are empty, SREAI falls back to a built-in
# rule-based analyzer (still useful — it recognizes OOM, disk-full, high CPU,
# nginx 5xx, connection-refused, and more).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
PORT=4477
REFRESH_MS=3000
